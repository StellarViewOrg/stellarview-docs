  },
  "api": {
    "openapi": "api-reference/openapi.yaml",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python",
        "go"
      ]
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "search": {
    "prompt": "Search StellarView docs"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "StellarView Docs",
      "twitter:card": "summary_large_image"
    }
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "This page moved or never existed. Try the search bar, or start from the [introduction](/)."
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/StellarViewOrg",
      "telegram": "https://t.me/stellarviewdata"
    }
  }
}
